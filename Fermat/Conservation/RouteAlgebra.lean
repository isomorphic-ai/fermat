# The strict twisted route algebra

The working route algebra is Mathlib's skew-polynomial normal form
`Lambda[R; #]`.  Its multiplication is generated by `R * a = a# * R`;
there is deliberately no relation on `R ^ 2`.  The closed return route
`C = R ^ 2` is central because `#` is involutive.

For an idempotent `e` exchanged with an orthogonal idempotent `e#`, every
odd route in `e A_route e` vanishes.  The corner is then the ordinary
polynomial ring over `e Lambda e`, with variable `e * R ^ 2`.
-/
import Fermat.Conservation.InvolutiveBase
import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.Algebra.SkewPolynomial.Basic
import Mathlib.RingTheory.Idempotents
import Mathlib.Tactic

noncomputable section

open Multiplicative

namespace Fermat.Conservation.RouteAlgebra

universe uLambda uO uDelta

/-- A chosen involutive ring endomorphism, written `#` in the route
presentation. -/
class HasSharp (Lambda : Type uLambda) [CommRing Lambda] where
  sharp : Lambda →+* Lambda
  sharp_involutive : ∀ a, sharp (sharp a) = a

/-- The action whose `n`th component is the `n`fold iterate of `#`. -/
@[reducible]
def sharpAction {Lambda : Type uLambda} [CommRing Lambda]
    (sharp : Lambda →+* Lambda) :
    MulSemiringAction (Multiplicative ℕ) Lambda :=
  MulSemiringAction.compHom Lambda (powersHom (Lambda →+* Lambda) sharp)

instance {Lambda : Type uLambda} [CommRing Lambda] [HasSharp Lambda] :
    MulSemiringAction (Multiplicative ℕ) Lambda :=
  sharpAction HasSharp.sharp

/-- The Teichmuller reflection supplies the sharp structure on the group
algebra.  It is intentionally a value, rather than a global instance, since
the character `omega` is data. -/
@[reducible]
def teichmullerSharp {O : Type uO} {Delta : Type uDelta}
    [CommRing O] [CommGroup Delta]
    (omega : InvolutiveBase.Character O Delta) :
    HasSharp (InvolutiveBase.GroupAlgebra O Delta) where
  sharp := (InvolutiveBase.hash omega).toAlgHom.toRingHom
  sharp_involutive := InvolutiveBase.hash_hash omega

/-- The named construction route: Mathlib's finitely supported strict
skew-polynomial normal form. -/
abbrev mathlibSkewPolynomialRoute (Lambda : Type uLambda)
    [CommRing Lambda] [HasSharp Lambda] :=
  SkewPolynomial Lambda

/-- `A_route = Lambda[R; #]`, with no relation imposed on `R ^ 2`. -/
abbrev Route (Lambda : Type uLambda) [CommRing Lambda] [HasSharp Lambda] :=
  mathlibSkewPolynomialRoute Lambda

variable {Lambda : Type uLambda} [CommRing Lambda] [HasSharp Lambda]

@[simp]
theorem phi_eq_sharp (a : Lambda) :
    SkewPolynomial.φ a = HasSharp.sharp a := by
  rfl

/-- The defining covariance `R a = a# R`. -/
theorem route_covariance (a : Lambda) :
    (SkewPolynomial.X : Route Lambda) * SkewPolynomial.C a =
      SkewPolynomial.C (HasSharp.sharp a) * SkewPolynomial.X := by
  rw [SkewPolynomial.X, SkewPolynomial.monomial_mul_C,
    SkewPolynomial.C_mul_monomial]
  simp only [Function.iterate_one, phi_eq_sharp, one_mul, mul_one]

@[simp]
theorem phi_sq (a : Lambda) :
    (SkewPolynomial.φ^[2]) a = a := by
  simp only [Function.iterate_succ_apply, Function.iterate_zero_apply,
    phi_eq_sharp, HasSharp.sharp_involutive]

@[simp]
theorem phi_even (n : ℕ) (a : Lambda) :
    (SkewPolynomial.φ^[2 * n]) a = a := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Nat.mul_succ, Function.iterate_add_apply, phi_sq, ih]

@[simp]
theorem phi_odd (n : ℕ) (a : Lambda) :
    (SkewPolynomial.φ^[2 * n + 1]) a = HasSharp.sharp a := by
  rw [Function.iterate_add_apply, Function.iterate_one, phi_even,
    phi_eq_sharp]

@[simp]
theorem even_smul (n : ℕ) (a : Lambda) :
    (Multiplicative.ofAdd (2 * n)) • a = a := by
  rw [← SkewPolynomial.φ_iterate_apply, phi_even]

@[simp]
theorem odd_smul (n : ℕ) (a : Lambda) :
    (Multiplicative.ofAdd (2 * n + 1)) • a = HasSharp.sharp a := by
  rw [← SkewPolynomial.φ_iterate_apply, phi_odd]

/-- The closed return route `C = R ^ 2`. -/
def closedRoute : Route Lambda :=
  (SkewPolynomial.X : Route Lambda) ^ 2

/-- In the strict route algebra, `C = R ^ 2` is central. -/
theorem closedRoute_central (p : Route Lambda) :
    closedRoute (Lambda := Lambda) * p = p * closedRoute := by
  rw [closedRoute, SkewPolynomial.X_pow_mul]
  simp_rw [phi_sq (Lambda := Lambda)]
  exact congrArg (fun q : Route Lambda ↦
      q * (SkewPolynomial.X : Route Lambda) ^ 2)
    (SkewPolynomial.sum_monomial p)

/-- The strict presentation does not identify `R ^ 2` with one.  Coefficient
two is an executable guard against accidentally importing the swap relation
upstream. -/
theorem closedRoute_ne_one [Nontrivial Lambda] :
    closedRoute (Lambda := Lambda) ≠ (1 : Route Lambda) := by
  intro h
  rw [closedRoute, ← SkewPolynomial.monomial_one_right_eq_X_pow] at h
  have hcoeff := congrArg
    (fun p : Route Lambda ↦ SkewPolynomial.coeff p 2) h
  simpa [SkewPolynomial.coeff_monomial, SkewPolynomial.coeff_one] using hcoeff

section Corner

variable (e : Lambda) (he : IsIdempotentElem e)

/-- The base idempotent embedded in the route algebra. -/
def routeIdempotent : Route Lambda := SkewPolynomial.C e

theorem routeIdempotent_isIdempotent (he : IsIdempotentElem e) :
    IsIdempotentElem (routeIdempotent e) :=
  IsIdempotentElem.map he SkewPolynomial.CRingHom

/-- The commutative coefficient corner `B_chi = e Lambda e`. -/
abbrev BaseCorner := he.Corner

/-- The corresponding corner of the strict route algebra. -/
abbrev RouteCorner := (routeIdempotent_isIdempotent e he).Corner

/-- Forget the proof that a coefficient lies in the base corner. -/
def baseCornerVal (b : BaseCorner e he) : Lambda := b.1

omit [HasSharp Lambda] in
@[simp]
theorem baseCornerVal_zero :
    baseCornerVal e he (0 : BaseCorner e he) = 0 := rfl

/-- The additive inclusion of the route corner into the ambient skew ring. -/
def routeCornerValAddHom : RouteCorner e he →+ Route Lambda where
  toFun x := x.1
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp]
theorem routeCornerValAddHom_apply (x : RouteCorner e he) :
    routeCornerValAddHom e he x = x.1 := rfl

/-- Coefficient extraction as an additive homomorphism. -/
def skewCoeffAddHom (n : ℕ) : Route Lambda →+ Lambda where
  toFun p := SkewPolynomial.coeff p n
  map_zero' := SkewMonoidAlgebra.coeff_zero _
  map_add' p q := SkewMonoidAlgebra.coeff_add p q _

theorem routeCorner_coeff_left (x : RouteCorner e he) (n : ℕ) :
    e * SkewPolynomial.coeff x.1 n = SkewPolynomial.coeff x.1 n := by
  have hx := (Subsemigroup.mem_corner_iff
    (routeIdempotent_isIdempotent e he)).mp x.2
  have hcoeff := congrArg
    (fun p : Route Lambda ↦ SkewPolynomial.coeff p n) hx.1
  change SkewMonoidAlgebra.coeff
    (SkewMonoidAlgebra.single 1 e * x.1) (Multiplicative.ofAdd n) = _ at hcoeff
  rw [SkewMonoidAlgebra.coeff_single_one_mul] at hcoeff
  exact hcoeff

theorem routeCorner_coeff_right (x : RouteCorner e he) (n : ℕ) :
    SkewPolynomial.coeff x.1 n * ((Multiplicative.ofAdd n) • e) =
      SkewPolynomial.coeff x.1 n := by
  have hx := (Subsemigroup.mem_corner_iff
    (routeIdempotent_isIdempotent e he)).mp x.2
  have hcoeff := congrArg
    (fun p : Route Lambda ↦ SkewPolynomial.coeff p n) hx.2
  change SkewMonoidAlgebra.coeff
    (x.1 * SkewMonoidAlgebra.single 1 e) (Multiplicative.ofAdd n) = _ at hcoeff
  rw [SkewMonoidAlgebra.coeff_mul_single_one] at hcoeff
  exact hcoeff

/-- The coefficient of the `n`th closed return route, regarded as an element
of the base corner. -/
def routeCornerEvenCoeff (x : RouteCorner e he) (n : ℕ) :
    BaseCorner e he := by
  refine ⟨SkewPolynomial.coeff x.1 (2 * n), ?_⟩
  apply (Subsemigroup.mem_corner_iff he).mpr
  refine ⟨routeCorner_coeff_left e he x (2 * n), ?_⟩
  simpa only [even_smul] using routeCorner_coeff_right e he x (2 * n)

/-- Orthogonality of `e` and `e#` kills every odd route in `e A_route e`.
This hypothesis is necessary: for a self-reflected idempotent, `e R e` need
not vanish. -/
theorem routeCorner_coeff_odd_eq_zero
    (horth : e * HasSharp.sharp e = 0)
    (x : RouteCorner e he) (n : ℕ) :
    SkewPolynomial.coeff x.1 (2 * n + 1) = 0 := by
  let c := SkewPolynomial.coeff x.1 (2 * n + 1)
  have hl : e * c = c := routeCorner_coeff_left e he x (2 * n + 1)
  have hr : c * HasSharp.sharp e = c := by
    simpa only [odd_smul] using routeCorner_coeff_right e he x (2 * n + 1)
  calc
    c = e * c := hl.symm
    _ = e * (c * HasSharp.sharp e) := congrArg (e * ·) hr.symm
    _ = (e * HasSharp.sharp e) * c := by ac_rfl
    _ = 0 := by rw [horth, zero_mul]

/-- Embed the base corner as constant routes. -/
def embedBaseCorner : BaseCorner e he →+* RouteCorner e he where
  toFun b := by
    refine ⟨SkewPolynomial.C b.1, ?_⟩
    apply (Subsemigroup.mem_corner_iff
      (routeIdempotent_isIdempotent e he)).mpr
    have hb := (Subsemigroup.mem_corner_iff he).mp b.2
    constructor
    · simpa only [routeIdempotent, ← SkewPolynomial.C_mul] using
        congrArg SkewPolynomial.C hb.1
    · simpa only [routeIdempotent, ← SkewPolynomial.C_mul] using
        congrArg SkewPolynomial.C hb.2
  map_one' := rfl
  map_mul' a b := Subtype.ext (SkewPolynomial.C_mul (a := a.1) (b := b.1))
  map_zero' := Subtype.ext SkewPolynomial.C_0
  map_add' a b := Subtype.ext (SkewPolynomial.C_add (a := a.1) (b := b.1))

/-- The corner's polynomial variable is `e * R ^ 2` (not the generally
non-corner element `R ^ 2`). -/
def cornerClosedRoute : RouteCorner e he := by
  let E : Route Lambda := routeIdempotent e
  let C : Route Lambda := closedRoute
  refine ⟨E * C, ?_⟩
  apply (Subsemigroup.mem_corner_iff
    (routeIdempotent_isIdempotent e he)).mpr
  constructor
  · dsimp only [E]
    rw [← mul_assoc, (routeIdempotent_isIdempotent e he).eq]
  · dsimp only [E, C]
    rw [mul_assoc, closedRoute_central (routeIdempotent e), ← mul_assoc,
      (routeIdempotent_isIdempotent e he).eq]

theorem embedBaseCorner_commute_cornerClosedRoute (b : BaseCorner e he) :
    Commute (embedBaseCorner e he b) (cornerClosedRoute e he) := by
  apply Subtype.ext
  simp only [embedBaseCorner, cornerClosedRoute]
  change SkewPolynomial.C b.1 *
      (routeIdempotent e * closedRoute) =
    (routeIdempotent e * closedRoute) * SkewPolynomial.C b.1
  calc
    SkewPolynomial.C b.1 * (routeIdempotent e * closedRoute) =
        (SkewPolynomial.C b.1 * routeIdempotent e) * closedRoute :=
      (mul_assoc ..).symm
    _ = (routeIdempotent e * SkewPolynomial.C b.1) * closedRoute := by
      simp only [routeIdempotent, ← SkewPolynomial.C_mul, mul_comm]
    _ = routeIdempotent e * (SkewPolynomial.C b.1 * closedRoute) :=
      mul_assoc ..
    _ = routeIdempotent e * (closedRoute * SkewPolynomial.C b.1) := by
      rw [closedRoute_central]
    _ = (routeIdempotent e * closedRoute) * SkewPolynomial.C b.1 :=
      (mul_assoc ..).symm

/-- Evaluation at the closed route gives the canonical map
`B_chi[C] -> e A_route e`. -/
def cornerPolynomialMap : Polynomial (BaseCorner e he) →+* RouteCorner e he :=
  Polynomial.eval₂RingHom' (embedBaseCorner e he) (cornerClosedRoute e he)
    (embedBaseCorner_commute_cornerClosedRoute e he)

theorem cornerClosedRoute_pow_val (n : ℕ) :
    ((cornerClosedRoute e he) ^ n).1 =
      routeIdempotent e * (SkewPolynomial.X : Route Lambda) ^ (2 * n) := by
  induction n with
  | zero =>
      change routeIdempotent e = routeIdempotent e * 1
      rw [mul_one]
  | succ n ih =>
      rw [pow_succ]
      change ((cornerClosedRoute e he) ^ n).1 * (cornerClosedRoute e he).1 = _
      rw [ih]
      simp only [cornerClosedRoute, closedRoute]
      let E : Route Lambda := routeIdempotent e
      let C : Route Lambda := (SkewPolynomial.X : Route Lambda) ^ 2
      have hCE : Commute C E := closedRoute_central E
      change (E * (SkewPolynomial.X : Route Lambda) ^ (2 * n)) * (E * C) =
        E * (SkewPolynomial.X : Route Lambda) ^ (2 * (n + 1))
      rw [pow_mul, pow_mul]
      calc
        (E * C ^ n) * (E * C) = E * (C ^ n * E) * C := by
          simp only [mul_assoc]
        _ = E * (E * C ^ n) * C := by rw [(hCE.pow_left n).eq]
        _ = (E * E) * (C ^ n * C) := by simp only [mul_assoc]
        _ = E * (C ^ n * C) := by
          rw [(routeIdempotent_isIdempotent e he).eq]
        _ = E * C ^ (n + 1) := by rw [pow_succ]

theorem cornerPolynomialMap_monomial_val
    (b : BaseCorner e he) (n : ℕ) :
    ((cornerPolynomialMap e he (Polynomial.monomial n b)).1 : Route Lambda) =
      SkewPolynomial.monomial (2 * n) (baseCornerVal e he b) := by
  rw [cornerPolynomialMap, Polynomial.eval₂RingHom'_apply,
    Polynomial.eval₂_monomial]
  change (embedBaseCorner e he b).1 * ((cornerClosedRoute e he) ^ n).1 = _
  rw [cornerClosedRoute_pow_val]
  change SkewPolynomial.C (baseCornerVal e he b) *
      (routeIdempotent e * SkewPolynomial.X ^ (2 * n)) = _
  simp only [routeIdempotent]
  rw [← mul_assoc, ← SkewPolynomial.C_mul]
  have hb : baseCornerVal e he b * e = baseCornerVal e he b :=
    ((Subsemigroup.mem_corner_iff he).mp b.2).2
  rw [hb, SkewPolynomial.C_mul_X_pow_eq_monomial]

theorem cornerPolynomialMap_val_eq_sum
    (p : Polynomial (BaseCorner e he)) :
    ((cornerPolynomialMap e he p).1 : Route Lambda) =
      p.sum (fun n b =>
        SkewPolynomial.monomial (2 * n) (baseCornerVal e he b)) := by
  rw [cornerPolynomialMap, Polynomial.eval₂RingHom'_apply,
    Polynomial.eval₂_eq_sum, Polynomial.sum_def, Polynomial.sum_def]
  change routeCornerValAddHom e he (∑ n ∈ p.support,
      (embedBaseCorner e he (p.coeff n)) * (cornerClosedRoute e he) ^ n) =
    ∑ n ∈ p.support,
      SkewPolynomial.monomial (2 * n) (baseCornerVal e he (p.coeff n))
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro n hn
  simpa only [routeCornerValAddHom_apply, cornerPolynomialMap,
    Polynomial.eval₂RingHom'_apply, Polynomial.eval₂_monomial] using
      cornerPolynomialMap_monomial_val e he (p.coeff n) n

theorem cornerPolynomialMap_coeff_even
    (p : Polynomial (BaseCorner e he)) (n : ℕ) :
    SkewPolynomial.coeff (cornerPolynomialMap e he p).1 (2 * n) =
      baseCornerVal e he (p.coeff n) := by
  rw [cornerPolynomialMap_val_eq_sum, Polynomial.sum_def]
  rw [show SkewPolynomial.coeff (∑ k ∈ p.support,
      SkewPolynomial.monomial (2 * k) (baseCornerVal e he (p.coeff k))) (2 * n) =
      skewCoeffAddHom (2 * n) (∑ k ∈ p.support,
        SkewPolynomial.monomial (2 * k) (baseCornerVal e he (p.coeff k))) by rfl]
  rw [map_sum]
  by_cases hn : p.coeff n = 0
  · simp [skewCoeffAddHom, SkewPolynomial.coeff_monomial,
      Polynomial.mem_support_iff, hn]
  · simp [skewCoeffAddHom, SkewPolynomial.coeff_monomial,
      Polynomial.mem_support_iff, hn]

theorem cornerPolynomialMap_coeff_odd
    (p : Polynomial (BaseCorner e he)) (n : ℕ) :
    SkewPolynomial.coeff (cornerPolynomialMap e he p).1 (2 * n + 1) = 0 := by
  rw [cornerPolynomialMap_val_eq_sum, Polynomial.sum_def]
  rw [show SkewPolynomial.coeff (∑ k ∈ p.support,
      SkewPolynomial.monomial (2 * k) (baseCornerVal e he (p.coeff k)))
        (2 * n + 1) =
      skewCoeffAddHom (2 * n + 1) (∑ k ∈ p.support,
        SkewPolynomial.monomial (2 * k) (baseCornerVal e he (p.coeff k))) by rfl]
  rw [map_sum]
  simp [skewCoeffAddHom, SkewPolynomial.coeff_monomial,
    Nat.two_mul_ne_two_mul_add_one]

/-- Read a route-corner element as the polynomial of its even
coefficients. -/
def cornerToPolynomial (x : RouteCorner e he) :
    Polynomial (BaseCorner e he) :=
  Polynomial.ofFinsupp <| Finsupp.onFinset
    (x.1.support.image (fun k => k / 2))
    (routeCornerEvenCoeff e he x)
    (by
      intro n hn
      have hcoeff : SkewPolynomial.coeff x.1 (2 * n) ≠ 0 := by
        intro hzero
        apply hn
        apply Subtype.ext
        change SkewPolynomial.coeff x.1 (2 * n) = (0 : Lambda)
        exact hzero
      apply Finset.mem_image.mpr
      refine ⟨2 * n, SkewPolynomial.mem_support_iff.mpr hcoeff, ?_⟩
      exact Nat.mul_div_right n (by decide))

@[simp]
theorem cornerToPolynomial_coeff (x : RouteCorner e he) (n : ℕ) :
    (cornerToPolynomial e he x).coeff n = routeCornerEvenCoeff e he x n := by
  rfl

theorem cornerPolynomialMap_injective :
    Function.Injective (cornerPolynomialMap e he) := by
  intro p q hpq
  apply Polynomial.ext
  intro n
  apply Subtype.ext
  change baseCornerVal e he (p.coeff n) = baseCornerVal e he (q.coeff n)
  simpa only [cornerPolynomialMap_coeff_even] using congrArg
    (fun x : RouteCorner e he => SkewPolynomial.coeff x.1 (2 * n)) hpq

theorem even_or_odd_index (m : ℕ) :
    (∃ n, m = 2 * n) ∨ (∃ n, m = 2 * n + 1) := by
  rcases Nat.even_or_odd m with ⟨n, hn⟩ | ⟨n, hn⟩
  · exact Or.inl ⟨n, by simpa [two_mul] using hn⟩
  · exact Or.inr ⟨n, hn⟩

theorem cornerPolynomialMap_cornerToPolynomial
    (horth : e * HasSharp.sharp e = 0) (x : RouteCorner e he) :
    cornerPolynomialMap e he (cornerToPolynomial e he x) = x := by
  apply Subtype.ext
  apply SkewPolynomial.ext
  intro m
  rcases even_or_odd_index m with ⟨n, rfl⟩ | ⟨n, rfl⟩
  · rw [cornerPolynomialMap_coeff_even, cornerToPolynomial_coeff]
    rfl
  · rw [routeCorner_coeff_odd_eq_zero e he horth x n]
    exact cornerPolynomialMap_coeff_odd e he (cornerToPolynomial e he x) n

theorem cornerPolynomialMap_surjective
    (horth : e * HasSharp.sharp e = 0) :
    Function.Surjective (cornerPolynomialMap e he) := by
  intro x
  exact ⟨cornerToPolynomial e he x,
    cornerPolynomialMap_cornerToPolynomial e he horth x⟩

/-- For an exchanged orthogonal idempotent, the strict route corner is the
ordinary polynomial ring `B_chi[C]`; its variable is the closed route
`e * R ^ 2`. -/
def cornerPolynomialEquiv (horth : e * HasSharp.sharp e = 0) :
    Polynomial (BaseCorner e he) ≃+* RouteCorner e he :=
  RingEquiv.ofBijective (cornerPolynomialMap e he)
    ⟨cornerPolynomialMap_injective e he,
      cornerPolynomialMap_surjective e he horth⟩

@[simp]
theorem cornerPolynomialEquiv_apply
    (horth : e * HasSharp.sharp e = 0)
    (p : Polynomial (BaseCorner e he)) :
    cornerPolynomialEquiv e he horth p = cornerPolynomialMap e he p :=
  RingEquiv.ofBijective_apply _ _ p

@[simp]
theorem cornerPolynomialEquiv_X (horth : e * HasSharp.sharp e = 0) :
    cornerPolynomialEquiv e he horth Polynomial.X = cornerClosedRoute e he := by
  rw [cornerPolynomialEquiv_apply]
  exact Polynomial.eval₂_X (embedBaseCorner e he) (cornerClosedRoute e he)

end Corner

end Fermat.Conservation.RouteAlgebra
