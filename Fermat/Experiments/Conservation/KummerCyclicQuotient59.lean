# Continuous cyclic Kummer quotients at 59

A primitive 59th root of unity and a radicand which is not a 59th power
produce a concrete degree-59 Kummer splitting field in an algebraic closure.
Its Galois group is continuously identified with `Multiplicative (ZMod 59)`,
and restriction from the absolute Galois group gives a surjective continuous
cyclic character.

This construction deliberately says nothing about lifting that character to
`Multiplicative (ZMod (59 ^ 2))`.  Such a lift is governed by the separate
cyclic-embedding/norm obstruction.
-/
import Fermat.Experiments.Conservation.ContinuousCyclicQuotient59
import Mathlib.FieldTheory.KummerExtension
import Mathlib.Tactic
import Mathlib.Topology.Instances.ZMod

open Polynomial

noncomputable section

namespace Fermat.Conservation.KummerCyclicQuotient59

variable (F : Type) [Field F]
variable (zeta a : F)
variable (hzeta : IsPrimitiveRoot zeta 59)
variable (ha : ∀ b : F, b ^ 59 ≠ a)

/-- The Kummer polynomial attached to a supplied non-power radicand. -/
abbrev kummerPolynomial59 : F[X] := X ^ 59 - C a

include ha
/-- A non-59th-power radicand makes its prime-degree Kummer polynomial
irreducible. -/
theorem kummerPolynomial59_irreducible :
    Irreducible (kummerPolynomial59 F a) := by
  exact (X_pow_sub_C_irreducible_iff_of_prime
    (by decide : Nat.Prime 59)).2 ha

omit ha

/-- The concrete Kummer extension generated by all roots in the chosen
algebraic closure. -/
def kummerExtension59 : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F
    ((kummerPolynomial59 F a).rootSet (AlgebraicClosure F))

/-- The concrete intermediate field is, by construction, the splitting
field of the Kummer polynomial. -/
theorem kummerExtension59_isSplittingField :
    IsSplittingField F (kummerExtension59 F a)
      (kummerPolynomial59 F a) := by
  exact IntermediateField.adjoin_rootSet_isSplittingField
    (IsAlgClosed.splits
      ((kummerPolynomial59 F a).map
        (algebraMap F (AlgebraicClosure F))))

include ha

/-- The finite Kummer Galois group, continuously identified with the
additive cyclic group `ZMod 59` written multiplicatively. -/
def kummerGalEquiv59 :
    ((kummerExtension59 F a) ≃ₐ[F] (kummerExtension59 F a)) ≃ₜ*
      Multiplicative (ZMod 59) := by
  letI : IsSplittingField F (kummerExtension59 F a)
      (kummerPolynomial59 F a) :=
    kummerExtension59_isSplittingField F a
  letI : FiniteDimensional F (kummerExtension59 F a) :=
    Polynomial.IsSplittingField.finiteDimensional
      (kummerExtension59 F a) (kummerPolynomial59 F a)
  letI : NeZero 59 := ⟨by decide⟩
  let e :
      ((kummerExtension59 F a) ≃ₐ[F] (kummerExtension59 F a)) ≃*
        Multiplicative (ZMod 59) :=
    autEquivZmod (kummerPolynomial59_irreducible F a ha)
      (kummerExtension59 F a) hzeta
  exact
    { e with
      continuous_toFun := continuous_of_discreteTopology
      continuous_invFun := continuous_of_discreteTopology }

/-- The continuous Kummer character obtained by restricting the absolute
Galois action to the supplied degree-59 Kummer extension. -/
def kummerCharacter59 :
    Field.absoluteGaloisGroup F →ₜ* Multiplicative (ZMod 59) := by
  letI : IsSplittingField F (kummerExtension59 F a)
      (kummerPolynomial59 F a) :=
    kummerExtension59_isSplittingField F a
  letI : IsGalois F (kummerExtension59 F a) :=
    isGalois_of_isSplittingField_X_pow_sub_C
      ⟨zeta, (mem_primitiveRoots (by decide : 0 < 59)).2 hzeta⟩
      (kummerPolynomial59_irreducible F a ha)
      (kummerExtension59 F a)
  exact ContinuousCyclicQuotient59.cyclicQuotient59 F
    (kummerExtension59 F a) (kummerGalEquiv59 F zeta a hzeta ha)

/-- Every element of the finite cyclic group occurs under the concrete
Kummer character. -/
theorem kummerCharacter59_surjective :
    Function.Surjective (kummerCharacter59 F zeta a hzeta ha) := by
  letI : IsSplittingField F (kummerExtension59 F a)
      (kummerPolynomial59 F a) :=
    kummerExtension59_isSplittingField F a
  letI : IsGalois F (kummerExtension59 F a) :=
    isGalois_of_isSplittingField_X_pow_sub_C
      ⟨zeta, (mem_primitiveRoots (by decide : 0 < 59)).2 hzeta⟩
      (kummerPolynomial59_irreducible F a ha)
      (kummerExtension59 F a)
  exact ContinuousCyclicQuotient59.cyclicQuotient59_surjective F
    (kummerExtension59 F a) (kummerGalEquiv59 F zeta a hzeta ha)

end Fermat.Conservation.KummerCyclicQuotient59
