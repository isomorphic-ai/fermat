# Continuous cyclic Kummer quotients at an arbitrary prime

A primitive `p`-th root of unity and a radicand which is not a `p`-th
power produce a concrete degree-`p` Kummer splitting field in an algebraic
closure.  Its Galois group is continuously identified with
`Multiplicative (ZMod p)`, and restriction from the absolute Galois group
gives a surjective continuous cyclic character.

This is the prime-parametric implementation underlying the older
order-59 specialization.  It deliberately makes no cyclic-`p^2` lifting or
norm-residue assertion.
-/
import Fermat.Experiments.Conservation.ContinuousCyclicQuotient
import Mathlib.FieldTheory.KummerExtension
import Mathlib.Tactic
import Mathlib.Topology.Instances.ZMod

open Polynomial

noncomputable section

namespace Fermat.Conservation.PrimeKummerCyclicQuotient

variable (p : ℕ) [Fact p.Prime]
variable (F : Type) [Field F]
variable (zeta a : F)
variable (hzeta : IsPrimitiveRoot zeta p)
variable (ha : ∀ b : F, b ^ p ≠ a)

/-- The Kummer polynomial attached to a supplied non-power radicand. -/
abbrev kummerPolynomial : F[X] := X ^ p - C a

include ha

/-- A non-`p`-th-power radicand makes its prime-degree Kummer polynomial
irreducible. -/
theorem kummerPolynomial_irreducible :
    Irreducible (kummerPolynomial p F a) := by
  exact (X_pow_sub_C_irreducible_iff_of_prime (Fact.out : p.Prime)).2 ha

omit ha

/-- The concrete Kummer extension generated by all roots in the chosen
algebraic closure. -/
def kummerExtension : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F
    ((kummerPolynomial p F a).rootSet (AlgebraicClosure F))

set_option linter.unusedSectionVars false in
/-- The concrete intermediate field is, by construction, the splitting
field of the Kummer polynomial. -/
theorem kummerExtension_isSplittingField :
    IsSplittingField F (kummerExtension p F a)
      (kummerPolynomial p F a) := by
  exact IntermediateField.adjoin_rootSet_isSplittingField
    (IsAlgClosed.splits
      ((kummerPolynomial p F a).map
        (algebraMap F (AlgebraicClosure F))))

include ha

/-- The finite Kummer Galois group, continuously identified with the
additive cyclic group `ZMod p` written multiplicatively. -/
def kummerGalEquiv :
    ((kummerExtension p F a) ≃ₐ[F] (kummerExtension p F a)) ≃ₜ*
      Multiplicative (ZMod p) := by
  letI : IsSplittingField F (kummerExtension p F a)
      (kummerPolynomial p F a) :=
    kummerExtension_isSplittingField p F a
  letI : FiniteDimensional F (kummerExtension p F a) :=
    Polynomial.IsSplittingField.finiteDimensional
      (kummerExtension p F a) (kummerPolynomial p F a)
  letI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  let e :
      ((kummerExtension p F a) ≃ₐ[F] (kummerExtension p F a)) ≃*
        Multiplicative (ZMod p) :=
    autEquivZmod (kummerPolynomial_irreducible p F a ha)
      (kummerExtension p F a) hzeta
  exact
    { e with
      continuous_toFun := continuous_of_discreteTopology
      continuous_invFun := continuous_of_discreteTopology }

/-- The continuous Kummer character obtained by restricting the absolute
Galois action to the supplied degree-`p` Kummer extension. -/
def kummerCharacter :
    Field.absoluteGaloisGroup F →ₜ* Multiplicative (ZMod p) := by
  letI : IsSplittingField F (kummerExtension p F a)
      (kummerPolynomial p F a) :=
    kummerExtension_isSplittingField p F a
  letI : IsGalois F (kummerExtension p F a) :=
    isGalois_of_isSplittingField_X_pow_sub_C
      ⟨zeta, (mem_primitiveRoots (Fact.out : p.Prime).pos).2 hzeta⟩
      (kummerPolynomial_irreducible p F a ha)
      (kummerExtension p F a)
  exact ContinuousCyclicQuotient.cyclicQuotient F p
    (kummerExtension p F a) (kummerGalEquiv p F zeta a hzeta ha)

/-- Every element of the finite cyclic group occurs under the concrete
Kummer character. -/
theorem kummerCharacter_surjective :
    Function.Surjective (kummerCharacter p F zeta a hzeta ha) := by
  letI : IsSplittingField F (kummerExtension p F a)
      (kummerPolynomial p F a) :=
    kummerExtension_isSplittingField p F a
  letI : IsGalois F (kummerExtension p F a) :=
    isGalois_of_isSplittingField_X_pow_sub_C
      ⟨zeta, (mem_primitiveRoots (Fact.out : p.Prime).pos).2 hzeta⟩
      (kummerPolynomial_irreducible p F a ha)
      (kummerExtension p F a)
  exact ContinuousCyclicQuotient.cyclicQuotient_surjective F p
    (kummerExtension p F a) (kummerGalEquiv p F zeta a hzeta ha)

end Fermat.Conservation.PrimeKummerCyclicQuotient
