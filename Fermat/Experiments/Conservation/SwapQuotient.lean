# The earned swap quotient and its two-account representation

The strict route algebra keeps the observable closed route `C = R ^ 2`.
Only this module imposes the additional relation `C = 1`, by an explicit
two-sided-ideal quotient.  Thus the image of `R` is an involution here without
collapsing route degree upstream.

On the sharp-fixed scalar part, the quotient is the usual `C₂` algebra.  Its
nontrivial element acts on two accounts by exchange.  Common/difference
coordinates identify this action with `diag(1, -1)`, and the corresponding
flow element acts by the interaction already defined in `Interaction.lean`.
-/
import Fermat.Experiments.Conservation.Interaction
import Fermat.Experiments.Conservation.RouteAlgebra
import Mathlib.Algebra.Module.TransferInstance
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.Tactic

noncomputable section

namespace Fermat.Conservation.SwapQuotient

open Fermat.Conservation.Interaction
open Fermat.Conservation.RouteAlgebra

universe uLambda

section Quotient

variable {Lambda : Type uLambda} [CommRing Lambda]
  [RouteAlgebra.HasSharp Lambda]

/-- The two-sided relation generated by `R ^ 2 - 1`, imposed only after the
strict route algebra has been constructed. -/
def swapIdeal : TwoSidedIdeal (RouteAlgebra.Route Lambda) :=
  TwoSidedIdeal.span
    ({RouteAlgebra.closedRoute (Lambda := Lambda) - 1} :
      Set (RouteAlgebra.Route Lambda))

/-- `A_swap = A_route / (R ^ 2 - 1)`. -/
abbrev Swap :=
  RouteAlgebra.Route Lambda ⧸ (swapIdeal (Lambda := Lambda)).asIdeal

/-- The explicit map earning the swap relation. -/
def quotientMap : RouteAlgebra.Route Lambda →+* Swap (Lambda := Lambda) :=
  Ideal.Quotient.mk (swapIdeal (Lambda := Lambda)).asIdeal

/-- The image of the open route `R`. -/
def generator : Swap (Lambda := Lambda) :=
  quotientMap (Lambda := Lambda)
    (SkewPolynomial.X : RouteAlgebra.Route Lambda)

/-- The strict-route word for relation (7a).  Its action on a two-account
state is `x - y`; the word itself is not asserted to vanish. -/
def sevenARouteWord : RouteAlgebra.Route Lambda :=
  1 - (SkewPolynomial.X : RouteAlgebra.Route Lambda)

/-- The strict-route word for relation (7d).  Its action on a two-account
state is `x + y`; the word itself is not asserted to vanish. -/
def sevenDRouteWord : RouteAlgebra.Route Lambda :=
  1 + (SkewPolynomial.X : RouteAlgebra.Route Lambda)

/-- The image of the relation-(7a) word in the earned swap quotient. -/
def sevenARelationWord : Swap (Lambda := Lambda) :=
  quotientMap (Lambda := Lambda) (sevenARouteWord (Lambda := Lambda))

/-- The image of the relation-(7d) word in the earned swap quotient. -/
def sevenDRelationWord : Swap (Lambda := Lambda) :=
  quotientMap (Lambda := Lambda) (sevenDRouteWord (Lambda := Lambda))

@[simp]
theorem sevenARelationWord_image :
    sevenARelationWord (Lambda := Lambda) =
      1 - generator (Lambda := Lambda) := by
  simp [sevenARelationWord, sevenARouteWord, generator]

@[simp]
theorem sevenDRelationWord_image :
    sevenDRelationWord (Lambda := Lambda) =
      1 + generator (Lambda := Lambda) := by
  simp [sevenDRelationWord, sevenDRouteWord, generator]

/-- The coefficient embedding into the swap quotient. -/
def coefficient : Lambda →+* Swap (Lambda := Lambda) :=
  (quotientMap (Lambda := Lambda)).comp SkewPolynomial.CRingHom

/-- The quotient map kills the declared closed-route relation. -/
theorem quotientMap_closedRoute :
    quotientMap (Lambda := Lambda)
        (RouteAlgebra.closedRoute (Lambda := Lambda)) = 1 := by
  rw [← sub_eq_zero, ← map_one (quotientMap (Lambda := Lambda)), ← map_sub]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [TwoSidedIdeal.mem_asIdeal]
  exact TwoSidedIdeal.subset_span (Set.mem_singleton _)

/-- The route generator becomes the nontrivial `C₂` element only in the
earned quotient. -/
@[simp]
theorem generator_sq :
    generator (Lambda := Lambda) ^ 2 = 1 := by
  rw [generator, ← map_pow, ← RouteAlgebra.closedRoute,
    quotientMap_closedRoute]

/-- Covariance survives the quotient. -/
theorem generator_coefficient (a : Lambda) :
    generator (Lambda := Lambda) * coefficient a =
      coefficient (RouteAlgebra.HasSharp.sharp a) * generator := by
  change quotientMap (Lambda := Lambda)
      ((SkewPolynomial.X : RouteAlgebra.Route Lambda) *
        SkewPolynomial.C a) =
    quotientMap (Lambda := Lambda)
      (SkewPolynomial.C (RouteAlgebra.HasSharp.sharp a) *
        SkewPolynomial.X)
  rw [RouteAlgebra.route_covariance]

/-- A scalar lies in the untwisted coefficient sector used by the ordinary
two-account representation. -/
def SharpFixed (a : Lambda) : Prop :=
  RouteAlgebra.HasSharp.sharp a = a

end Quotient

section FlowElement

variable {Lambda : Type uLambda} [Field Lambda]
  [RouteAlgebra.HasSharp Lambda]

/-- The scalar one-half inside the earned quotient. -/
def coefficientHalf : Swap (Lambda := Lambda) :=
  coefficient ((2 : Lambda)⁻¹)

/-- The common-mode idempotent `pi_common = (1 + R) / 2`. -/
def piCommon : Swap (Lambda := Lambda) :=
  coefficientHalf * (1 + generator)

/-- The difference-mode idempotent `pi_diff = (1 - R) / 2`. -/
def piDifference : Swap (Lambda := Lambda) :=
  coefficientHalf * (1 - generator)

theorem sharp_inv_two :
    RouteAlgebra.HasSharp.sharp ((2 : Lambda)⁻¹) = (2 : Lambda)⁻¹ := by
  rw [map_inv₀, map_ofNat]

/-- One-half is in the sharp-fixed scalar sector, so it commutes with the
swap generator. -/
theorem coefficientHalf_commute_generator :
    Commute (coefficientHalf (Lambda := Lambda))
      (generator (Lambda := Lambda)) := by
  apply Commute.symm
  change generator (Lambda := Lambda) * coefficient ((2 : Lambda)⁻¹) =
    coefficient ((2 : Lambda)⁻¹) * generator
  simpa only [coefficientHalf, sharp_inv_two] using
    generator_coefficient (Lambda := Lambda) ((2 : Lambda)⁻¹)

variable [NeZero (2 : Lambda)]

theorem coefficientHalf_add_self :
    coefficientHalf (Lambda := Lambda) + coefficientHalf = 1 := by
  change coefficient ((2 : Lambda)⁻¹) + coefficient ((2 : Lambda)⁻¹) = 1
  rw [← map_add, ← map_one (coefficient (Lambda := Lambda))]
  congr 1
  field_simp
  norm_num

/-- The two quotient projectors exhaust the identity. -/
theorem piCommon_add_piDifference :
    piCommon (Lambda := Lambda) + piDifference = 1 := by
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  change h * (1 + s) + h * (1 - s) = 1
  calc
    h * (1 + s) + h * (1 - s) = h + h := by noncomm_ring
    _ = 1 := coefficientHalf_add_self (Lambda := Lambda)

/-- The common-mode element is an idempotent in `A_swap`. -/
theorem piCommon_idempotent :
    IsIdempotentElem (piCommon (Lambda := Lambda)) := by
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  let q := 1 + s
  have hcomm : Commute h s :=
    coefficientHalf_commute_generator (Lambda := Lambda)
  have hqcomm : Commute h q := (Commute.one_right h).add_right hcomm
  have hqpow : (h * q) ^ 2 = h ^ 2 * q ^ 2 := hqcomm.mul_pow 2
  have hss : s * s = 1 := by
    simpa only [pow_two] using generator_sq (Lambda := Lambda)
  have hqsq : q ^ 2 = q + q := by
    dsimp only [q]
    noncomm_ring [hss]
  change (h * q) * (h * q) = h * q
  rw [← pow_two, hqpow, hqsq]
  calc
    h ^ 2 * (q + q) = (h + h) * (h * q) := by noncomm_ring
    _ = h * q := by
      rw [coefficientHalf_add_self (Lambda := Lambda), one_mul]

/-- The difference-mode element is an idempotent in `A_swap`. -/
theorem piDifference_idempotent :
    IsIdempotentElem (piDifference (Lambda := Lambda)) := by
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  let q := 1 - s
  have hcomm : Commute h s :=
    coefficientHalf_commute_generator (Lambda := Lambda)
  have hqcomm : Commute h q := (Commute.one_right h).sub_right hcomm
  have hqpow : (h * q) ^ 2 = h ^ 2 * q ^ 2 := hqcomm.mul_pow 2
  have hss : s * s = 1 := by
    simpa only [pow_two] using generator_sq (Lambda := Lambda)
  have hqsq : q ^ 2 = q + q := by
    dsimp only [q]
    noncomm_ring [hss]
  change (h * q) * (h * q) = h * q
  rw [← pow_two, hqpow, hqsq]
  calc
    h ^ 2 * (q + q) = (h + h) * (h * q) := by noncomm_ring
    _ = h * q := by
      rw [coefficientHalf_add_self (Lambda := Lambda), one_mul]

/-- The common and difference quotient summands are orthogonal. -/
theorem piCommon_piDifference_orthogonal :
    piCommon (Lambda := Lambda) * piDifference (Lambda := Lambda) = 0 ∧
      piDifference (Lambda := Lambda) * piCommon (Lambda := Lambda) = 0 := by
  have _two_ne_zero : (2 : Lambda) ≠ 0 := two_ne_zero
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  let qp := 1 + s
  let qm := 1 - s
  have hs : Commute h s :=
    coefficientHalf_commute_generator (Lambda := Lambda)
  have hqp : Commute h qp := (Commute.one_right h).add_right hs
  have hqm : Commute h qm := (Commute.one_right h).sub_right hs
  have hss : s * s = 1 := by
    simpa only [pow_two] using generator_sq (Lambda := Lambda)
  have hpzero : qp * qm = 0 := by
    dsimp only [qp, qm]
    noncomm_ring [hss]
  have hmzero : qm * qp = 0 := by
    dsimp only [qp, qm]
    noncomm_ring [hss]
  change (h * qp) * (h * qm) = 0 ∧ (h * qm) * (h * qp) = 0
  constructor
  · calc
      (h * qp) * (h * qm) = h * (qp * h) * qm := by
        simp only [mul_assoc]
      _ = h * (h * qp) * qm := by rw [hqp.symm.eq]
      _ = (h * h) * (qp * qm) := by simp only [mul_assoc]
      _ = 0 := by rw [hpzero, mul_zero]
  · calc
      (h * qm) * (h * qp) = h * (qm * h) * qp := by
        simp only [mul_assoc]
      _ = h * (h * qm) * qp := by rw [hqm.symm.eq]
      _ = (h * h) * (qm * qp) := by simp only [mul_assoc]
      _ = 0 := by rw [hmzero, mul_zero]

/-- Erratum E1, derived in the earned quotient: the (7a) word is a `-1`
eigenvector for the swap.  The common projector kills it and the difference
projector fixes it. -/
theorem sevenARelationWord_eigenspace :
    generator (Lambda := Lambda) * sevenARelationWord (Lambda := Lambda) =
        -sevenARelationWord (Lambda := Lambda) ∧
      piCommon (Lambda := Lambda) * sevenARelationWord (Lambda := Lambda) = 0 ∧
      piDifference (Lambda := Lambda) * sevenARelationWord (Lambda := Lambda) =
        sevenARelationWord (Lambda := Lambda) := by
  rw [sevenARelationWord_image]
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  have hs : s * s = 1 := by
    simpa only [pow_two] using generator_sq (Lambda := Lambda)
  have hh : h + h = 1 := coefficientHalf_add_self (Lambda := Lambda)
  change s * (1 - s) = -(1 - s) ∧
    (h * (1 + s)) * (1 - s) = 0 ∧
    (h * (1 - s)) * (1 - s) = 1 - s
  constructor
  · noncomm_ring [hs]
  · constructor
    · noncomm_ring [hs]
    · calc
        (h * (1 - s)) * (1 - s) = (h + h) * (1 - s) := by
          noncomm_ring [hs]
        _ = 1 - s := by rw [hh, one_mul]

/-- Erratum E1, derived in the earned quotient: the proved (7d) word is a
`+1` eigenvector for the swap.  The common projector fixes it and the
difference projector kills it. -/
theorem sevenDRelationWord_eigenspace :
    generator (Lambda := Lambda) * sevenDRelationWord (Lambda := Lambda) =
        sevenDRelationWord (Lambda := Lambda) ∧
      piCommon (Lambda := Lambda) * sevenDRelationWord (Lambda := Lambda) =
        sevenDRelationWord (Lambda := Lambda) ∧
      piDifference (Lambda := Lambda) * sevenDRelationWord (Lambda := Lambda) = 0 := by
  rw [sevenDRelationWord_image]
  let h := coefficientHalf (Lambda := Lambda)
  let s := generator (Lambda := Lambda)
  have hs : s * s = 1 := by
    simpa only [pow_two] using generator_sq (Lambda := Lambda)
  have hh : h + h = 1 := coefficientHalf_add_self (Lambda := Lambda)
  change s * (1 + s) = 1 + s ∧
    (h * (1 + s)) * (1 + s) = 1 + s ∧
    (h * (1 - s)) * (1 + s) = 0
  constructor
  · noncomm_ring [hs]
  · constructor
    · calc
        (h * (1 + s)) * (1 + s) = (h + h) * (1 + s) := by
          noncomm_ring [hs]
        _ = 1 + s := by rw [hh, one_mul]
    · noncomm_ring [hs]

/-- The quotient flow element `(1 - g/2) + (g/2)R`.  Its ordinary scalar
interpretation is used below when `g` is sharp-fixed. -/
def flowElement (g : Lambda) : Swap (Lambda := Lambda) :=
  coefficient (1 - g / 2) + coefficient (g / 2) * generator

/-- At gain two, the quotient flow element is the pure swap generator. -/
theorem flowElement_two :
    flowElement (Lambda := Lambda) (2 : Lambda) = generator := by
  simp [flowElement, two_ne_zero]

end FlowElement

section InteractionBridge

variable (K : Type*)

/-- Coordinate identification used to put the existing account structure in
the usual rank-two module. -/
def accountCoordinates : Interaction.TwoAccount K ≃ K × K where
  toFun x := (x.left, x.right)
  invFun p := ⟨p.1, p.2⟩
  left_inv x := by cases x; rfl
  right_inv p := by cases p; rfl

instance [Field K] : AddCommGroup (Interaction.TwoAccount K) :=
  (accountCoordinates K).addCommGroup

instance [Field K] : Module K (Interaction.TwoAccount K) :=
  (accountCoordinates K).module K

variable {K}

@[simp]
theorem account_add_left [Field K] (x y : Interaction.TwoAccount K) :
    (x + y).left = x.left + y.left := rfl

@[simp]
theorem account_add_right [Field K] (x y : Interaction.TwoAccount K) :
    (x + y).right = x.right + y.right := rfl

@[simp]
theorem account_smul_left [Field K] (a : K) (x : Interaction.TwoAccount K) :
    (a • x).left = a * x.left := rfl

@[simp]
theorem account_smul_right [Field K] (a : K) (x : Interaction.TwoAccount K) :
    (a • x).right = a * x.right := rfl

@[simp]
theorem account_zero_left [Field K] :
    (0 : Interaction.TwoAccount K).left = 0 := rfl

@[simp]
theorem account_zero_right [Field K] :
    (0 : Interaction.TwoAccount K).right = 0 := rfl

@[simp]
theorem account_neg_left [Field K] (x : Interaction.TwoAccount K) :
    (-x).left = -x.left := rfl

@[simp]
theorem account_neg_right [Field K] (x : Interaction.TwoAccount K) :
    (-x).right = -x.right := rfl

@[simp]
theorem account_sub_left [Field K] (x y : Interaction.TwoAccount K) :
    (x - y).left = x.left - y.left := rfl

@[simp]
theorem account_sub_right [Field K] (x y : Interaction.TwoAccount K) :
    (x - y).right = x.right - y.right := rfl

/-- The nontrivial element of `C₂` acts by account exchange. -/
def swapLinear [Field K] :
    Interaction.TwoAccount K →ₗ[K] Interaction.TwoAccount K where
  toFun := Interaction.TwoAccount.swap
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem swapLinear_apply [Field K] (x : Interaction.TwoAccount K) :
    swapLinear x = x.swap := rfl

/-- The represented generator satisfies the quotient relation. -/
theorem swapLinear_sq [Field K] :
    swapLinear (K := K) * swapLinear = LinearMap.id := by
  apply LinearMap.ext
  intro x
  exact Interaction.TwoAccount.swap_swap x

variable [Field K] [NeZero (2 : K)]

/-- Common/difference coordinates: the trivial and sign summands of the
two-dimensional `C₂` representation. -/
def commonDifference : Interaction.TwoAccount K ≃ₗ[K] K × K where
  toFun x := (x.sum, x.difference)
  invFun p := ⟨(p.1 + p.2) / 2, (p.1 - p.2) / 2⟩
  left_inv x := by
    ext <;> simp only [Interaction.TwoAccount.sum,
      Interaction.TwoAccount.difference] <;> field_simp <;> ring
  right_inv p := by
    ext <;> simp only [Interaction.TwoAccount.sum,
      Interaction.TwoAccount.difference] <;> field_simp <;> ring
  map_add' x y := by
    ext <;> simp [Interaction.TwoAccount.sum,
      Interaction.TwoAccount.difference] <;> ring
  map_smul' a x := by
    ext <;> simp [Interaction.TwoAccount.sum,
      Interaction.TwoAccount.difference] <;> ring

/-- The bridge theorem: in the `s/d` decomposition, the swap quotient's
generator is the `C₂` character decomposition `diag(1, -1)`. -/
theorem commonDifference_swap (x : Interaction.TwoAccount K) :
    commonDifference (swapLinear x) =
      ((commonDifference x).1, -(commonDifference x).2) := by
  ext <;> simp [commonDifference, swapLinear, Interaction.TwoAccount.sum,
    Interaction.TwoAccount.difference]
  all_goals ring

/-- Projector onto the common (trivial-character) summand. -/
def commonProjector :
    Interaction.TwoAccount K →ₗ[K] Interaction.TwoAccount K where
  toFun x := ⟨x.sum / 2, x.sum / 2⟩
  map_add' x y := by
    ext <;> simp [Interaction.TwoAccount.sum] <;> ring
  map_smul' a x := by
    ext <;> simp [Interaction.TwoAccount.sum] <;> ring

/-- Projector onto the difference (sign-character) summand. -/
def differenceProjector :
    Interaction.TwoAccount K →ₗ[K] Interaction.TwoAccount K where
  toFun x := ⟨x.difference / 2, -x.difference / 2⟩
  map_add' x y := by
    ext <;> simp [Interaction.TwoAccount.difference] <;> ring
  map_smul' a x := by
    ext <;> simp [Interaction.TwoAccount.difference] <;> ring

/-- Under the sharp-fixed scalar `C₂` action, the quotient formula
`pi_common = (1 + R) / 2` is the common-mode linear projector. -/
theorem commonProjector_formula :
    commonProjector (K := K) =
      (2 : K)⁻¹ • (LinearMap.id + swapLinear (K := K)) := by
  apply LinearMap.ext
  intro x
  ext <;> simp [commonProjector, swapLinear,
    Interaction.TwoAccount.sum]
  all_goals field_simp
  all_goals ring

/-- Under the sharp-fixed scalar `C₂` action, the quotient formula
`pi_diff = (1 - R) / 2` is the difference-mode linear projector. -/
theorem differenceProjector_formula :
    differenceProjector (K := K) =
      (2 : K)⁻¹ • (LinearMap.id - swapLinear (K := K)) := by
  apply LinearMap.ext
  intro x
  ext <;> simp [differenceProjector, swapLinear,
    Interaction.TwoAccount.difference] <;> field_simp

theorem projector_sum :
    commonProjector (K := K) + differenceProjector (K := K) =
      LinearMap.id := by
  apply LinearMap.ext
  intro x
  ext <;> simp [commonProjector, differenceProjector,
    Interaction.TwoAccount.sum, Interaction.TwoAccount.difference] <;>
    field_simp <;> ring

theorem commonProjector_idempotent :
    commonProjector (K := K) * commonProjector (K := K) =
      commonProjector (K := K) := by
  apply LinearMap.ext
  intro x
  ext <;> simp [commonProjector, Interaction.TwoAccount.sum]

theorem differenceProjector_idempotent :
    differenceProjector (K := K) * differenceProjector (K := K) =
      differenceProjector (K := K) := by
  apply LinearMap.ext
  intro x
  ext <;> simp [differenceProjector, Interaction.TwoAccount.difference] <;>
    field_simp <;> ring

theorem projector_orthogonal :
    commonProjector (K := K) * differenceProjector (K := K) = 0 ∧
      differenceProjector (K := K) * commonProjector (K := K) = 0 := by
  constructor
  · apply LinearMap.ext
    intro x
    ext <;> simp [commonProjector, differenceProjector,
      Interaction.TwoAccount.sum, Interaction.TwoAccount.difference,
      two_ne_zero] <;>
      field_simp <;> ring
  · apply LinearMap.ext
    intro x
    ext <;> simp [commonProjector, differenceProjector,
      Interaction.TwoAccount.sum, Interaction.TwoAccount.difference]

theorem commonDifference_commonProjector (x : Interaction.TwoAccount K) :
    commonDifference (commonProjector x) = (x.sum, 0) := by
  ext <;> simp [commonDifference, commonProjector,
    Interaction.TwoAccount.sum, Interaction.TwoAccount.difference]

theorem commonDifference_differenceProjector (x : Interaction.TwoAccount K) :
    commonDifference (differenceProjector x) = (0, x.difference) := by
  ext <;> simp [commonDifference, differenceProjector,
    Interaction.TwoAccount.sum, Interaction.TwoAccount.difference] <;>
    field_simp <;> ring

omit [NeZero (2 : K)] in
/-- In the ordinary two-account representation, the (7a) quotient word
`1 - R` reads exactly as the difference mode `(x-y, y-x)`. -/
theorem sevenARelationOperator_apply (x : Interaction.TwoAccount K) :
    ((LinearMap.id : Interaction.TwoAccount K →ₗ[K]
        Interaction.TwoAccount K) - swapLinear (K := K)) x =
      ⟨x.difference, -x.difference⟩ := by
  ext <;> simp [swapLinear, Interaction.TwoAccount.difference]

omit [NeZero (2 : K)] in
/-- In the ordinary two-account representation, the (7d) quotient word
`1 + R` reads exactly as the common mode `(x+y, x+y)`. -/
theorem sevenDRelationOperator_apply (x : Interaction.TwoAccount K) :
    ((LinearMap.id : Interaction.TwoAccount K →ₗ[K]
        Interaction.TwoAccount K) + swapLinear (K := K)) x =
      ⟨x.sum, x.sum⟩ := by
  ext <;> simp [swapLinear, Interaction.TwoAccount.sum, add_comm]

/-- The sharp-fixed scalar action of the quotient flow element.  A full
twisted-coefficient representation requires additional semilinear data; this
operator intentionally represents only the ordinary `C₂` scalar sector. -/
def flowOperator (g : K) :
    Interaction.TwoAccount K →ₗ[K] Interaction.TwoAccount K :=
  (1 - g / 2) • LinearMap.id + (g / 2) • swapLinear

/-- The represented quotient flow is exactly the existing interaction step. -/
theorem flowOperator_apply (g : K) (x : Interaction.TwoAccount K) :
    flowOperator g x = x.step g := by
  ext <;> simp [flowOperator, swapLinear, Interaction.TwoAccount.step,
    Interaction.TwoAccount.flow, Interaction.TwoAccount.difference] <;>
    field_simp <;> ring

/-- Gain two is the pure swap in both the quotient and `Interaction.lean`. -/
theorem flowOperator_two :
    flowOperator (2 : K) = swapLinear (K := K) := by
  apply LinearMap.ext
  intro x
  rw [flowOperator_apply, Interaction.TwoAccount.step_two_eq_swap]
  rfl

end InteractionBridge

end Fermat.Conservation.SwapQuotient
