# C5: generator-derived gauge coordinates

The gauge used to read credit flow is generated by the same cyclic
recursion as C2.  The high derivative on the edge from `g^i` to `g^(i+1)`
has finite-field coefficient

`(g^(2 * i))^(row + 1) * (g^(2 * (row + 1)) - 1)`.

Consequently its matrix is a row- and column-scaled transpose
Vandermonde.  No matrix and no inverse matrix are certificate fields.
-/
import Fermat.Experiments.Conservation.Credit.Capacity
import Mathlib.Algebra.Field.ZMod
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.LinearAlgebra.Matrix.ToLinearEquiv
import Mathlib.LinearAlgebra.Vandermonde

open scoped BigOperators

namespace Fermat.Conservation.Credit.Gauge

/-- The generic gauge interface at an odd prime.

The exact order law identifies this generator with the `rank + 1` recursion
which underlies C2.  Everything else in this file is derived from these
fields. -/
structure GaugeData (p : ℕ) where
  rank : ℕ
  prime : Nat.Prime p
  odd : Odd p
  rank_spec :
    p = 2 * (rank + 1) + 1
  orbitGenerator : (ZMod p)ˣ
  orbitGenerator_order :
    orderOf orbitGenerator = rank + 1
  /-- The even high derivatives see the square of the real-orbit
  generator.  Exactness is necessary: when squaring halves its order, the
  displayed high-flow matrix necessarily repeats columns. -/
  orbitGenerator_square_order :
    orderOf (orbitGenerator ^ 2) = rank + 1

namespace GaugeData

variable {p : ℕ} (data : GaugeData p)

/-- The closing power law needed to build the C2 multiplication cycle. -/
theorem orbitGenerator_pow_rank_add_one :
    data.orbitGenerator ^ (data.rank + 1) = 1 := by
  rw [← data.orbitGenerator_order]
  exact pow_orderOf_eq_one data.orbitGenerator

/-- The C2 cycle obtained from the gauge generator.  This is not a second
orbit datum. -/
def cycle : Credit.Cycle ((ZMod p)ˣ) :=
  Credit.Cycle.ofMul data.rank data.orbitGenerator
    data.orbitGenerator_pow_rank_add_one

@[simp]
theorem cycle_rank :
    data.cycle.rank = data.rank :=
  rfl

@[simp]
theorem cycle_point (n : ℕ) :
    data.cycle.point n = data.orbitGenerator ^ n := by
  exact Credit.Cycle.ofMul_point data.rank data.orbitGenerator
    data.orbitGenerator_pow_rank_add_one n

/-- Exactness survives squaring only when the real-cycle order is odd. -/
theorem realCycleOrder_odd :
    Odd (data.rank + 1) := by
  rw [← Nat.coprime_two_right, Nat.coprime_iff_gcd_eq_one]
  have horder := data.orbitGenerator_square_order
  rw [orderOf_pow' _ (by norm_num), data.orbitGenerator_order] at horder
  exact (Nat.div_eq_self.mp horder).resolve_left (by omega)

/-- Thus this even-derivative gauge applies to the `3 mod 4` branch of odd
prime conductors.  On the `1 mod 4` branch the square nodes repeat and a
different generator/degree convention is required. -/
theorem prime_mod_four_eq_three (data : GaugeData p) :
    p % 4 = 3 := by
  obtain ⟨k, hk⟩ := realCycleOrder_odd data
  rw [data.rank_spec, hk]
  omega

/-- The Vandermonde nodes seen by the even high derivatives:
`1, g^2, ..., (g^2)^(rank - 1)`. -/
def orbitNode (i : Fin data.rank) : ZMod p :=
  (((data.orbitGenerator ^ 2) ^ i.val : (ZMod p)ˣ) : ZMod p)

/-- The exponents used by `orbitNode` lie in the exact-order range. -/
private theorem orbitNode_exponent_lt_order (i : Fin data.rank) :
    i.val < orderOf (data.orbitGenerator ^ 2) := by
  rw [data.orbitGenerator_square_order]
  omega

/-- Distinct positions in the generated orbit give distinct Vandermonde
nodes. -/
theorem orbitNode_injective :
    Function.Injective data.orbitNode := by
  intro i j hij
  have hpowers :
      (data.orbitGenerator ^ 2) ^ i.val =
        (data.orbitGenerator ^ 2) ^ j.val := by
    apply Units.ext
    exact hij
  have hexponents :
      i.val = j.val :=
    pow_injOn_Iio_orderOf
      (data.orbitNode_exponent_lt_order i)
      (data.orbitNode_exponent_lt_order j)
      hpowers
  exact Fin.ext hexponents

/-- No displayed nontrivial power of the squared orbit generator is one. -/
theorem orbitGenerator_square_pow_succ_ne_one (i : Fin data.rank) :
    (data.orbitGenerator ^ 2) ^ (i.val + 1) ≠ 1 := by
  intro hpow
  have hdvd : orderOf (data.orbitGenerator ^ 2) ∣ i.val + 1 :=
    orderOf_dvd_of_pow_eq_one hpow
  rw [data.orbitGenerator_square_order] at hdvd
  exact (Nat.not_dvd_of_pos_of_lt (by omega) (by omega)) hdvd

/-- The generator-derived scale of character row `row`. -/
def rowScale (row : Fin data.rank) : ZMod p :=
  ((((data.orbitGenerator ^ 2) ^ (row.val + 1) : (ZMod p)ˣ) :
      ZMod p) - 1)

/-- Every generator-derived scale is nonzero. -/
theorem rowScale_ne_zero (row : Fin data.rank) :
    data.rowScale row ≠ 0 := by
  letI : Fact (Nat.Prime p) := ⟨data.prime⟩
  apply sub_ne_zero.mpr
  intro h
  apply data.orbitGenerator_square_pow_succ_ne_one row
  apply Units.ext
  simpa using h

/-- The edge index contributes one further Vandermonde node, changing
power `row` to power `row + 1`. -/
def columnScale (i : Fin data.rank) : ZMod p :=
  data.orbitNode i

/-- Every column scale is a unit. -/
theorem columnScale_ne_zero (i : Fin data.rank) :
    data.columnScale i ≠ 0 := by
  letI : Fact (Nat.Prime p) := ⟨data.prime⟩
  exact Units.ne_zero ((data.orbitGenerator ^ 2) ^ i.val)

/-- The raw-to-character change of coordinates.  Its `(row, i)` entry is
the `row + 1` power of the `i`th generated node, times the generated row
scale.  The matrix is a definition, not certificate data. -/
def characterMatrix :
    Matrix (Fin data.rank) (Fin data.rank) (ZMod p) :=
  Matrix.diagonal data.rowScale *
    (Matrix.vandermonde data.orbitNode).transpose *
      Matrix.diagonal data.columnScale

/-- Entry formula for the row- and column-scaled transpose Vandermonde
matrix. -/
theorem characterMatrix_apply (row i : Fin data.rank) :
    data.characterMatrix row i =
      data.rowScale row * data.orbitNode i ^ (row.val + 1) := by
  rw [characterMatrix, Matrix.mul_diagonal, Matrix.diagonal_mul]
  simp only [columnScale]
  simp [Matrix.vandermonde, pow_succ, mul_assoc]

/-- The gauge entry is exactly the finite-field reduction of the generated
edge difference at the high derivative degree `2 * (row + 1) * p`. -/
theorem characterMatrix_eq_high_edge_difference
    (row i : Fin data.rank) :
    data.characterMatrix row i =
      (((data.cycle.point (i.val + 1) : (ZMod p)ˣ) : ZMod p) ^
          (2 * (row.val + 1) * p) -
        ((data.cycle.point i.val : (ZMod p)ˣ) : ZMod p) ^
          (2 * (row.val + 1) * p)) := by
  letI : Fact (Nat.Prime p) := ⟨data.prime⟩
  rw [data.characterMatrix_apply]
  simp only [data.cycle_point]
  have hpow (x : ZMod p) (n : ℕ) : x ^ (n * p) = x ^ n := by
    rw [pow_mul, ZMod.pow_card]
  rw [hpow, hpow]
  simp only [rowScale, orbitNode, Units.val_pow_eq_pow_val]
  simp only [← pow_mul]
  rw [sub_mul, one_mul, ← pow_add]
  congr 1 <;> ring

/-- The generator-derived gauge matrix is nonsingular. -/
theorem characterMatrix_det_ne_zero :
    data.characterMatrix.det ≠ 0 := by
  letI : Fact (Nat.Prime p) := ⟨data.prime⟩
  rw [characterMatrix, Matrix.det_mul, Matrix.det_mul,
    Matrix.det_transpose, Matrix.det_diagonal, Matrix.det_diagonal]
  exact mul_ne_zero
    (mul_ne_zero
      (Finset.prod_ne_zero_iff.mpr
        (fun row _ ↦ data.rowScale_ne_zero row))
      (Matrix.det_vandermonde_ne_zero_iff.mpr data.orbitNode_injective))
    (Finset.prod_ne_zero_iff.mpr
      (fun i _ ↦ data.columnScale_ne_zero i))

/-- Character coordinates are obtained by applying the one
generator-derived matrix to raw edge coordinates. -/
def characterCoordinates
    (raw : Fin data.rank → ZMod p) : Fin data.rank → ZMod p :=
  data.characterMatrix.mulVec raw

/-- The gauge transform has zero kernel modulo `p`: vanishing character
coordinates force every raw generated-edge coordinate to vanish. -/
theorem raw_eq_zero_of_character_eq_zero
    (raw : Fin data.rank → ZMod p)
    (hcharacter : data.characterCoordinates raw = 0) :
    raw = 0 := by
  letI : Fact (Nat.Prime p) := ⟨data.prime⟩
  by_contra hraw
  have hsingular : data.characterMatrix.det = 0 :=
    Matrix.exists_mulVec_eq_zero_iff.mp
      ⟨raw, hraw, by
        simpa only [characterCoordinates] using hcharacter⟩
  exact data.characterMatrix_det_ne_zero hsingular

/-- Equivalently, the generator-derived character transform is injective. -/
theorem characterCoordinates_injective :
    Function.Injective data.characterCoordinates := by
  intro left right heq
  have hzero :
      data.characterCoordinates (left - right) = 0 := by
    letI : Fact (Nat.Prime p) := ⟨data.prime⟩
    change data.characterMatrix.mulVec (left - right) = 0
    rw [Matrix.mulVec_sub]
    change data.characterCoordinates left -
      data.characterCoordinates right = 0
    rw [heq, sub_self]
  have := data.raw_eq_zero_of_character_eq_zero (left - right) hzero
  exact sub_eq_zero.mp this

end GaugeData

end Fermat.Conservation.Credit.Gauge
