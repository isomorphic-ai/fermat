# The finite cyclic Albert overfield at 59

This module completes the finite-extension layer of the constructive Albert
descent.  The overfield has dimension `59 ^ 2 = 3481` over the base field,
the 3481 powers of the lifted automorphism are distinct, and the general
automorphism-count bound shows that these powers exhaust the automorphism
group.  Hence the overfield is Galois and its Galois group is generated by
the constructed Albert lift.

This module deliberately stops before transport into a chosen algebraic
closure.  It does not yet construct an equivalent intermediate field of
`AlgebraicClosure F`, prove that restriction from the absolute Galois group
lands in this concrete cyclic group, or package the resulting continuous
surjective `C_(59^2)` quotient.  Those are the remaining transport and
topological steps; none is hidden in the declarations below.
-/
import Fermat.Experiments.Conservation.AlbertOrder59
import Mathlib.Tactic

open Polynomial

noncomputable section

namespace Fermat.Conservation.AlbertGalois59

open AlbertExtension59 AlbertOrder59

variable {F L : Type} [Field F] [Field L] [Algebra F L]
variable [FiniteDimensional F L] [IsGalois F L]

local instance : NeZero 59 := ⟨by decide⟩

variable (b : Lˣ)

omit [IsGalois F L] in
theorem albertOverfield59_finrank
    (hb : ∀ c : L, c ^ 59 ≠ (b : L))
    (hfinrank : Module.finrank F L = 59) :
    Module.finrank F (albertOverfield59 b) = 3481 := by
  letI : Fact (Irreducible (albertPolynomial59 b)) :=
    ⟨albertPolynomial59_irreducible b hb⟩
  letI : Module.Finite L (albertOverfield59 b) :=
    Module.Finite.of_basis
      (AdjoinRoot.powerBasis (albertPolynomial59_irreducible b hb).ne_zero).basis
  rw [← Module.finrank_mul_finrank F L (albertOverfield59 b), hfinrank,
    (AdjoinRoot.powerBasis
      (albertPolynomial59_irreducible b hb).ne_zero).finrank,
    AdjoinRoot.powerBasis_dim, natDegree_X_pow_sub_C]

variable (sigma : L ≃ₐ[F] L) (beta : L)

theorem albertLiftAlgEquiv59_distinct_powers
    (zeta : F) (hzeta : IsPrimitiveRoot zeta 59)
    (hratio : sigma (b : L) / (b : L) = beta ^ 59)
    (hb : ∀ c : L, c ^ 59 ≠ (b : L))
    (hsigma : ∀ rho : L ≃ₐ[F] L, rho ∈ Subgroup.zpowers sigma)
    (hfinrank : Module.finrank F L = 59)
    (hbeta : Algebra.norm F beta = zeta) :
    Function.Injective (fun i : Fin 3481 ↦
      albertLiftAlgEquiv59 sigma beta b hratio hb ^ (i : ℕ)) := by
  let tau := albertLiftAlgEquiv59 sigma beta b hratio hb
  have htau : orderOf tau = 3481 :=
    albertLiftAlgEquiv59_orderOf (b := b) (sigma := sigma) (beta := beta)
      zeta hzeta hratio hb hsigma hfinrank hbeta
  intro i j hij
  apply Fin.ext
  have hmod := pow_eq_pow_iff_modEq.mp hij
  rw [htau] at hmod
  apply Nat.ModEq.eq_of_lt_of_lt hmod
  · exact i.isLt
  · exact j.isLt

theorem albertOverfield59_card_aut
    (zeta : F) (hzeta : IsPrimitiveRoot zeta 59)
    (hratio : sigma (b : L) / (b : L) = beta ^ 59)
    (hb : ∀ c : L, c ^ 59 ≠ (b : L))
    (hsigma : ∀ rho : L ≃ₐ[F] L, rho ∈ Subgroup.zpowers sigma)
    (hfinrank : Module.finrank F L = 59)
    (hbeta : Algebra.norm F beta = zeta) :
    Nat.card
      (albertOverfield59 b ≃ₐ[F] albertOverfield59 b) = 3481 := by
  letI : Fact (Irreducible (albertPolynomial59 b)) :=
    ⟨albertPolynomial59_irreducible b hb⟩
  letI : FiniteDimensional L (albertOverfield59 b) :=
    Module.Finite.of_basis
      (AdjoinRoot.powerBasis (albertPolynomial59_irreducible b hb).ne_zero).basis
  letI : FiniteDimensional F (albertOverfield59 b) :=
    FiniteDimensional.trans F L (albertOverfield59 b)
  let tau := albertLiftAlgEquiv59 sigma beta b hratio hb
  have htau : orderOf tau = 3481 :=
    albertLiftAlgEquiv59_orderOf (b := b) (sigma := sigma) (beta := beta)
      zeta hzeta hratio hb hsigma hfinrank hbeta
  have hdim : Module.finrank F (albertOverfield59 b) = 3481 :=
    albertOverfield59_finrank b hb hfinrank
  apply Nat.le_antisymm
  · rw [← hdim]
    simpa only [Nat.card_eq_fintype_card] using
      (AlgEquiv.card_le
        (F := F) (K := albertOverfield59 b))
  · rw [← htau]
    exact orderOf_le_card

theorem albertOverfield59_isGalois
    (zeta : F) (hzeta : IsPrimitiveRoot zeta 59)
    (hratio : sigma (b : L) / (b : L) = beta ^ 59)
    (hb : ∀ c : L, c ^ 59 ≠ (b : L))
    (hsigma : ∀ rho : L ≃ₐ[F] L, rho ∈ Subgroup.zpowers sigma)
    (hfinrank : Module.finrank F L = 59)
    (hbeta : Algebra.norm F beta = zeta) :
    letI : Fact (Irreducible (albertPolynomial59 b)) :=
      ⟨albertPolynomial59_irreducible b hb⟩
    IsGalois F (albertOverfield59 b) := by
  letI : Fact (Irreducible (albertPolynomial59 b)) :=
    ⟨albertPolynomial59_irreducible b hb⟩
  letI : FiniteDimensional L (albertOverfield59 b) :=
    Module.Finite.of_basis
      (AdjoinRoot.powerBasis (albertPolynomial59_irreducible b hb).ne_zero).basis
  letI : FiniteDimensional F (albertOverfield59 b) :=
    FiniteDimensional.trans F L (albertOverfield59 b)
  apply IsGalois.of_card_aut_eq_finrank F (albertOverfield59 b)
  rw [albertOverfield59_card_aut b sigma beta zeta hzeta hratio hb hsigma hfinrank hbeta,
    albertOverfield59_finrank b hb hfinrank]

theorem albertLiftAlgEquiv59_zpowers_eq_top
    (zeta : F) (hzeta : IsPrimitiveRoot zeta 59)
    (hratio : sigma (b : L) / (b : L) = beta ^ 59)
    (hb : ∀ c : L, c ^ 59 ≠ (b : L))
    (hsigma : ∀ rho : L ≃ₐ[F] L, rho ∈ Subgroup.zpowers sigma)
    (hfinrank : Module.finrank F L = 59)
    (hbeta : Algebra.norm F beta = zeta) :
    Subgroup.zpowers (albertLiftAlgEquiv59 sigma beta b hratio hb) = ⊤ := by
  letI : Fact (Irreducible (albertPolynomial59 b)) :=
    ⟨albertPolynomial59_irreducible b hb⟩
  letI : FiniteDimensional L (albertOverfield59 b) :=
    Module.Finite.of_basis
      (AdjoinRoot.powerBasis (albertPolynomial59_irreducible b hb).ne_zero).basis
  letI : FiniteDimensional F (albertOverfield59 b) :=
    FiniteDimensional.trans F L (albertOverfield59 b)
  apply (Subgroup.card_eq_iff_eq_top _).mp
  rw [Nat.card_zpowers,
    albertLiftAlgEquiv59_orderOf (b := b) (sigma := sigma) (beta := beta)
      zeta hzeta hratio hb hsigma hfinrank hbeta,
    albertOverfield59_card_aut b sigma beta zeta hzeta hratio hb hsigma hfinrank hbeta]

end Fermat.Conservation.AlbertGalois59
