set_option maxHeartbeats 0
set_option maxRecDepth 1000000

local instance : Fact (Nat.Prime 1831) := ⟨by decide⟩
local instance : Fact (Nat.Prime 18311) := ⟨by norm_num⟩

/-- The symbol exponent in 18311 - 1 = 10 * 1831. -/
def symbolExponent : ℕ := 10

/-- The order-1831 residue root 2^10 modulo 18311. -/
def residueRoot : ZMod 18311 := 1024

/-- The chosen residue root has exact order 1831. -/
theorem residueRoot_isPrimitive : IsPrimitiveRoot residueRoot 1831 := by
  rw [IsPrimitiveRoot.iff_orderOf]
  apply orderOf_eq_prime
  · change (1024 : ZMod 18311) ^ 1831 = 1
    calc
      (1024 : ZMod 18311) ^ 1831 = ((2 : ZMod 18311) ^ 10) ^ 1831 := by
        norm_num
      _ = (2 : ZMod 18311) ^ (10 * 1831) := by rw [pow_mul]
      _ = (2 : ZMod 18311) ^ (18311 - 1) := by norm_num
      _ = 1 := ZMod.pow_card_sub_one_eq_one (by decide)
  · change (1024 : ZMod 18311) ≠ 1
    decide

