/-! ## The generated finite-field unfolding -/

local instance : Fact (Nat.Prime 59) := ⟨by norm_num⟩
local instance : Fact (Nat.Prime attestationPrime) :=
  ⟨attestationPrime_isPrime⟩

/-- The row root is generated by advancing through the nontrivial first
half of the order-59 root cycle. -/
def rowRoot (j : LedgerNode) : ZMod attestationPrime :=
  attestationRoot ^ (j.val + 1)

/-- The exponent at the `n`th node of the one order-29 recursion. -/
def nodeExponent (n : ℕ) : ℕ :=
  ZMod.val ((exponentGenerator ^ n : (ZMod 59)ˣ) : ZMod 59)

/-- Evaluation of the geometric unit at a generated row root. -/
def geometricResidue (j : LedgerNode) (n : ℕ) :
    ZMod attestationPrime :=
  ∑ k ∈ Finset.range (nodeExponent n), rowRoot j ^ k

/-- The residue of the real projection is the product of the two conjugate
geometric evaluations. -/
def realNodeResidue (j : LedgerNode) (n : ℕ) :
    ZMod attestationPrime :=
  geometricResidue j n *
    ∑ k ∈ Finset.range (nodeExponent n), (rowRoot j)⁻¹ ^ k

/-- Residue of the generated edge from node `i` to node `i+1`. -/
def edgeResidue (j i : LedgerNode) : ZMod attestationPrime :=
  realNodeResidue j (i.val + 1) / realNodeResidue j i.val

/-- A computable discrete logarithm on the particular fourteenth powers
that occur in the generated edge matrix.  Uniqueness is supplied later by
the exact order of `attestationRoot`; for computation it is useful to keep
the finite search visible. -/
def generatedMatrix : Matrix LedgerNode LedgerNode (ZMod 59) :=
  fun j i ↦
    ∑ k : Fin 59,
      if edgeResidue j i ^ (2 * 7) = attestationRoot ^ k.val
      then (k.val : ZMod 59)
      else 0

